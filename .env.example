# Variables de entorno del proyecto (ejemplo).
# Django NO lee este archivo solo: hay que cargarlas en la terminal antes de
# correr el sistema (ver README, sección «Variables de entorno»).
# Nunca subir el .env real al repositorio (ya está en .gitignore).

# Clave secreta de Django. Usar un valor largo y aleatorio propio.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# 1 = modo desarrollo (muestra errores detallados). Cualquier otro valor = producción.
DJANGO_DEBUG=1

# Cómo se ajustan los factores a 8 decimales: "redondear" (medio hacia arriba,
# lo que pide el HDU) o "truncar" (corta los decimales sobrantes).
FACTORES_MODO_REDONDEO=redondear
